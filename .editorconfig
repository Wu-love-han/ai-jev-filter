# ---- 编辑器统一规范（配合 .gitattributes 使用） ----
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,css,html,json,yml,yaml,md}]
indent_style = space
indent_size = 2

[*.bat]
end_of_line = crlf
charset = utf-8

[*.md]
trim_trailing_whitespace = false

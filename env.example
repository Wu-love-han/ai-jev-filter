# ============================================================================
# JEV 代理环境变量模板（复制为 .env 后填写；.env 已被 .gitignore 忽略）
#   copy env.example .env
#   下面所有值都是占位符，禁止把真实 Key 提交到任何仓库
#
#   代理把浏览器请求转成官方形状 POST {BASE}/v1/systemone
#   开源 ollaya 与官方 TypeSafe 是 wire-identical 的，所以只换模式/地址即可。
# ============================================================================

# ---- 代理监听（默认只绑本机；不要改成 0.0.0.0，除非你明确要做局域网/公网部署） ----
JEV_PROXY_HOST=127.0.0.1
JEV_PROXY_PORT=8787

# ---- 上游模式 ----
# ollaya      = 本地 ollaya 守护进程（开源，默认 http://127.0.0.1:11435，无需 Key）
# typesafe    = TypeSafe 官方云端（需 API Key）
# openai      = 任意 OpenAI 兼容接口（/v1/chat/completions），问题会被编译成 JSON 输出
# passthrough = 直接把 {state, model, questions} 透传给自定义 JEV 服务
JEV_UPSTREAM_MODE=ollaya

# ---- 上游地址（ollaya/typesafe 填服务根地址；openai 可填到 /v1 或完整 /chat/completions） ----
JEV_BASE_URL=http://127.0.0.1:11435
# 官方云端示例：https://api.typesafe.ai
# OpenAI 兼容示例：http://127.0.0.1:11434
JEV_UPSTREAM_URL=

# ---- 模型名 ----
# ollaya 模型：laya:multilingual（中文/多语言，CPU 可跑） · winnow:e4b · kev ...
# 官方云端：jev-latest（生产建议 pin 到具体版本，如 jev-1.13.0）
# openai 模式：你的本地模型名
JEV_MODEL=laya:multilingual

# ---- API Key（只从服务端环境变量读取，浏览器永远拿不到） ----
# 本地 ollaya 不需要；官方云端需要。
JEV_API_KEY=
# TypeSafe 官方 Key 也可以直接放这里
# TYPESAFE_API_KEY=YOUR_API_KEY_HERE

# ---- 超时（毫秒） ----
JEV_TIMEOUT_MS=30000
